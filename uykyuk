--====================== 3. MATH / ENTITY =============================
local atan2 = math.atan2 or function(y, x) return math.atan(y, x) end

local function vec(x, y, z) return { x = x, y = y, z = z } end

local function origin(e)
    local x, y, z = call("entity.get_origin", e)
    if type(x) ~= "number" then
        x, y, z = call("entity.get_prop", e, "m_vecOrigin")
    end
    if type(x) ~= "number" then return nil end
    return vec(x, y, z)
end

local function eye(e)
    local o = origin(e)
    if not o then return nil end
    return vec(o.x, o.y, o.z + 64)
end

local function alive(e)
    if not e then return false end
    local a = call("entity.is_alive", e)
    if a ~= nil then return a and true or false end
    return call("entity.get_prop", e, "m_lifeState") == 0
end

local function health(e) return call("entity.get_prop", e, "m_iHealth") or 0 end
local function team(e)   return call("entity.get_prop", e, "m_iTeamNum") or 0 end
local function pname(e)  return call("entity.get_player_name", e) or "player" end

local function hitpos(e, idx)
    local x, y, z = call("entity.hitbox_position", e, idx)
    if type(x) ~= "number" then return nil end
    return vec(x, y, z)
end

local HITBOX = { Head = 0, Neck = 1, Chest = 4, Stomach = 5, Pelvis = 6 }

local function view_angles()
    local p, y = call("engine.get_view_angles")
    return p or 0, y or 0
end

local function write_angles(p, y)
    if p > 89 then p = 89 end
    if p < -89 then p = -89 end
    y = y % 360
    if y > 180 then y = y - 360 end
    call("engine.set_view_angles", p, y, 0)
end

local function calc(src, dst)
    local dx, dy, dz = dst.x - src.x, dst.y - src.y, dst.z - src.z
    local yaw   = math.deg(atan2(dy, dx))
    local pitch = -math.deg(atan2(dz, math.sqrt(dx * dx + dy * dy)))
    return pitch, yaw
end

local function adelta(p1, y1, p2, y2)
    local dp = p1 - p2
    local dy = math.abs((y1 - y2 + 180) % 360 - 180)
    return math.sqrt(dp * dp + dy * dy)
end

local function dist3(a, b)
    local dx, dy, dz = a.x - b.x, a.y - b.y, a.z - b.z
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function enemies()
    return call("entity.get_players", true) or {}
end

local function visible(me, e, point)
    if not get(SA.vis, false) then return true end
    local src = eye(me)
    if not src then return false end
    local frac, ent = call("client.trace_line", src.x, src.y, src.z, point.x, point.y, point.z)
    if type(frac) ~= "number" then return true end
    if frac >= 0.97 then return true end
    return ent == e
end

--====================== 4. RENDER ====================================
local TXT = "nl"
do
    local f = api("renderer.text")
    if type(f) == "function" then
        if not pcall(f, 0, 0, 255, 255, 255, 255, " ", 0) then
            TXT = "gs"
        end
    end
end

local function txt(x, y, c, s, size)
    local f = api("renderer.text")
    if type(f) ~= "function" then return end
    if TXT == "nl" then
        if pcall(f, x, y, c[1], c[2], c[3], c[4], s, size or 0) then return end
    end
    pcall(f, x, y, c[1], c[2], c[3], c[4], 0, 4096, s)
end

local function rect(x, y, w, h, c) call("renderer.rect", x, y, w, h, c[1], c[2], c[3], c[4]) end
local function line(x1, y1, x2, y2, c) call("renderer.line", x1, y1, x2, y2, c[1], c[2], c[3], c[4]) end
local function circle(x, y, r, c) call("renderer.circle", x, y, c[1], c[2], c[3], c[4], r, 0, 1) end

local function w2s(x, y, z)
    local sx, sy, a = call("renderer.world_to_screen", x, y, z)
    if type(sx) ~= "number" then return nil end
    if a and a <= 0 then return nil end
    return sx, sy
end

local function screen()
    local w, h = call("client.screen_size")
    return w or 1920, h or 1080
end

