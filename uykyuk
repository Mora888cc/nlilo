local DEBUG = true

--====================== 0. LUA COMPAT ================================
local unpack = table.unpack or unpack

local function pack(...)
    return { n = select("#", ...), ... }
end

local function log(...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[#parts + 1] = tostring((select(i, ...)))
    end
    local s = "[neverse] " .. table.concat(parts, " ")
    local done = false
    for _, path in ipairs({ "client.log", "client.color_log", "console.log" }) do
        local cur = _G
        local ok = true
        for p in path:gmatch("[^%.]+") do
            if type(cur) ~= "table" then ok = false break end
            cur = cur[p]
        end
        if ok and type(cur) == "function" then
            if pcall(cur, s) then done = true break end
            if pcall(cur, 255, 255, 255, s) then done = true break end
        end
    end
    if not done then pcall(print, s) end
end

local function api(path)
    local cur = _G
    for p in path:gmatch("[^%.]+") do
        if type(cur) ~= "table" then return nil end
        cur = cur[p]
    end
    return cur
end

local function call(path, ...)
    local f = api(path)
    if type(f) ~= "function" then return nil end
    local r = pack(pcall(f, ...))
    if r[1] then return unpack(r, 2, r.n) end
    return nil
end

--====================== 1. UI LAYER ==================================
local UI = api("ui") or {}

local function uiNew(names, ...)
    local args = pack(...)
    for _, n in ipairs(names) do
        local f = UI[n]
        if type(f) == "function" then
            local ok, o = pcall(f, unpack(args, 1, args.n))
            if ok and o then return o end
        end
    end
    return nil
end

local function setItem(item, v)
    if not item then return end
    for _, n in ipairs({ "set" }) do
        if type(UI[n]) == "function" then
            if pcall(UI[n], item, v) then return end
        end
    end
    if type(item) == "table" and item.set then pcall(item.set, item, v) end
end

local function get(item, def)
    if not item then return def end
    local v = call("ui.get", item)
    if v ~= nil then return v end
    if type(item) == "table" and item.get then
        local ok, r = pcall(item.get, item)
        if ok and r ~= nil then return r end
    end
    if type(item) == "function" then
        local ok, r = pcall(item)
        if ok and r ~= nil then return r end
    end
    return def
end

local function on(item, fn)
    if not item then return end
    for _, path in ipairs({ "ui.set_callback", "ui.set_on_change", "ui.set_change_callback" }) do
        local f = api(path)
        if type(f) == "function" then
            if pcall(f, item, fn) then return end
        end
    end
    if type(item) == "table" and item.set_callback then
        pcall(item.set_callback, item, fn)
    end
end

local function check(tab, grp, label, def)
    local o = uiNew({ "new_checkbox", "add_checkbox", "create_checkbox" }, tab, grp, label)
    if not o then return nil end
    if def ~= nil then
        local cur = get(o, nil)
        if cur == nil then setItem(o, def) end
    end
    return o
end

local function slider(tab, grp, label, mn, mx, def, suffix)
    local o = uiNew({ "new_slider", "add_slider", "create_slider" },
                    tab, grp, label, mn, mx, def, 1, suffix or "")
    if not o then
        o = uiNew({ "new_slider", "add_slider", "create_slider" },
                  tab, grp, label, mn, mx, def)
    end
    return o
end

local function combo(tab, grp, label, items, def)
    local o = uiNew({ "new_combobox", "add_combobox", "create_combobox" },
                    tab, grp, label, items)
    if not o then
        o = uiNew({ "new_combobox", "add_combobox", "create_combobox" },
                  tab, grp, label, unpack(items))
    end
    if o and def then setItem(o, def) end
    return o
end

local function colorpick(tab, grp, label, r, g, b, a)
    return uiNew({ "new_color_picker", "add_color_picker", "create_color_picker" },
                 tab, grp, label, r, g, b, a)
end

local function hotkey(tab, grp, label)
    return uiNew({ "new_hotkey", "add_hotkey", "create_hotkey" }, tab, grp, label)
end

