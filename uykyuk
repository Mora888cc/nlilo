    white  = { 255, 255, 255, 255 },
    dim    = { 150, 150, 158, 200 },
    accent = { 92, 120, 255, 255 },
    heal   = { 70, 220, 130, 255 },
    hurt   = { 255, 62, 62, 255 },
    black  = { 0, 0, 0, 200 },
}

local function esp_color()
    if PL.color then
        local r, g, b, a = call("ui.get", PL.color)
        if type(r) == "number" then return { r, g, b, a or 255 } end
    end
    return { 255, 60, 60, 255 }
end

--====================== 5. BACKTRACK =================================
local Records = {}

local function record()
    local now = call("globals.curtime") or 0
    local ms  = get(RC.btms, 140) / 1000
    local live = {}

    for _, e in ipairs(enemies()) do
        if alive(e) then
            live[e] = true
            local o = origin(e)
            if o then
                Records[e] = Records[e] or {}
                local list = Records[e]
                list[#list + 1] = { t = now, p = o }
                while #list > 0 and now - list[1].t > ms do
                    table.remove(list, 1)
                end
            end
        end
    end

    for e in pairs(Records) do
        if not live[e] then Records[e] = nil end
    end
end

local function backtrack_pos(e)
    local list = Records[e]
    if not list or #list == 0 then return nil end
    local want = (call("globals.curtime") or 0) - (get(RC.btms, 140) / 1000)
    local best, bestd
    for _, r in ipairs(list) do
        local d = math.abs(r.t - want)
        if not bestd or d < bestd then best, bestd = r, d end
    end
    return best and best.p or nil
end

--====================== 6. TARGET ====================================
local Target, TargetAng = nil, nil

local function pick(me)
    local src = eye(me)
    if not src then return nil end

    local vp, vy = view_angles()
    local fov    = get(SA.fov, 180)
    local hb     = HITBOX[get(RB.hitbox, "Head")] or 0
    local myteam = team(me)
    local maxd   = get(SA.maxdist, 4000)
    local prio   = get(RB.priority, "Closest to crosshair")

    local best, bestScore, bestAng

    for _, e in ipairs(enemies()) do
        if alive(e) then
            local skip = false
            if get(SA.team, true) and team(e) == myteam then skip = true end

            if not skip then
                local point = hitpos(e, hb) or hitpos(e, 0)
                if not point and get(RC.backtrack, true) then
                    point = backtrack_pos(e)
                end

                if point then
                    local d3 = dist3(src, point)
                    if d3 <= maxd then
                        local p, y = calc(src, point)
                        local d = adelta(vp, vy, p, y)
                        if d <= fov and visible(me, e, point) then
                            local score
                            if prio == "Closest to crosshair" then score = d
                            elseif prio == "Lowest health" then score = health(e)
                            else score = d3 end
                            if not bestScore or score < bestScore then
                                best, bestScore, bestAng = e, score, { p, y }
                            end
                        end
                    end
                end
            end
        end
    end

    return best, bestAng
end

--====================== 7. AIM =======================================
local keyHeld   = true
local aimToggle = true

on(SA.key,    function() keyHeld   = not keyHeld   end)
on(MN.aimkey, function() aimToggle = not aimToggle end)

local function is_attack(cmd)
    if not cmd then return true end
    local ok, v = pcall(function() return cmd.in_attack end)
    if ok and v ~= nil then return v == 1 or v == true end
    return true
end

local function silent_aim(cmd)
    Target, TargetAng = nil, nil
    if not get(SA.enabled, true) then return end
    if not (keyHeld and aimToggle) then return end

    local me = call("entity.get_local_player")
    if not alive(me) then return end

    local e, ang = pick(me)
    if not e or not ang then return end
    Target, TargetAng = e, ang

    if get(SA.silent, true) then
        if not is_attack(cmd) then return end
        if cmd and cmd.set_view_angles then
            if pcall(function() cmd:set_view_angles(ang[1], ang[2], 0) end) then return end
        end
        write_angles(ang[1], ang[2])
    else
        local vp, vy = view_angles()
        local f = 1 / math.max(1, get(SA.smooth, 1))
        write_angles(vp + (ang[1] - vp) * f,
                     vy + ((ang[2] - vy + 180) % 360 - 180) * f)
    end

    if get(SA.autofire, false) and cmd then
        pcall(function() cmd.in_attack = 1 end)
    end
end

--====================== 8. RCS =======================================
local rcs_x, rcs_y = 0, 0

local function rcs()
    if not get(RC.enable, true) then return end
    local me = call("entity.get_local_player")
    if not alive(me) then return end
    local hp = get(RC.horizontal, 0) / 100
    local vp = get(RC.vertical, 0) / 100
    if hp == 0 and vp == 0 then return end
    if rcs_x ~= 0 or rcs_y ~= 0 then
        local p, y = view_angles()
        write_angles(p - rcs_x * (1 - vp), y - rcs_y * (1 - hp))
        rcs_x, rcs_y = 0, 0
    end
end

--====================== 9. ESP =======================================
local function draw_box(x1, y1, x2, y2, col)
    line(x1, y1, x2, y1, col)
    line(x1, y2, x2, y2, col)
    line(x1, y1, x1, y2, col)
    line(x2, y1, x2, y2, col)
end

local function draw_esp()
    if not get(PL.enable, true) then return end
    local me     = call("entity.get_local_player")
    local eyePos = me and eye(me)
    local col    = esp_color()
    local myteam = me and team(me) or 0
    local maxd   = get(PL.maxdist, 1500)
    local sw, sh = screen()

    for _, e in ipairs(enemies()) do
        if alive(e) then
            local skip = false
            if get(PL.team, true) and team(e) == myteam then skip = true end
            if not skip then
                local o, head = origin(e), hitpos(e, 0)
                if o and head then
                    local d = eyePos and dist3(eyePos, o) or 0
                    if d <= maxd then
                        local hx, hy = w2s(head.x, head.y, head.z + 8)
                        local fx, fy = w2s(o.x, o.y, o.z)
                        if hx and fx then
                            local h = math.abs(fy - hy)
                            local w = h * 0.5
                            local x = hx - w * 0.5
                            if get(PL.box, true) then draw_box(x, hy, x + w, fy, col) end
                            if get(PL.health, true) then
                                local hp = math.max(0, math.min(1, health(e) / 100))
                                rect(x - 5, hy, 2, h, C.black)
                                rect(x - 5, fy - h * hp, 2, h * hp,
                                     hp > 0.5 and C.heal or C.hurt)
                            end
                            if get(PL.name, true) then txt(hx, hy - 14, col, pname(e)) end
                            if get(PL.distance, true) then
                                txt(hx, fy + 2, C.dim, string.format("%d m", math.floor(d / 48)))
                            end
                            if get(PL.flags, true) then
                                txt(x + w + 4, hy + 1, C.dim, health(e) .. " hp")
                            end
                            if get(PL.tracer, false) then line(sw / 2, sh, hx, fy, col) end
                        end
                    end
                end
            end
        end
    end
end

--====================== 10. VISUALS ==================================
local function draw_fov()
    if not get(WD.fovcircle, true) then return end
    local sw, sh = screen()
    local r = (sw / 2) * math.tan(math.rad(get(SA.fov, 180) * 0.5))
    circle(sw / 2, sh / 2, math.max(6, r), Target and C.heal or C.dim)
end

local function draw_crosshair()
    if not get(WD.crosshair, false) then return end
    local sw, sh = screen()
    rect(sw / 2 - 1, sh / 2 - 1, 2, 2, C.white)
end

local function draw_lock()
    if not (Target and TargetAng) then return end
    local o = origin(Target)
    if not o then return end
    local sx, sy = w2s(o.x, o.y, o.z + 72)
    if sx then txt(sx, sy - 12, C.heal, "LOCK") end
end

local function draw_watermark()
    if not get(MN.watermark, true) then return end
    local sw = screen()
    local flags = {}
    if get(SA.enabled, true)  then flags[#flags + 1] = "SILENT" end
    if get(SA.silent, true)   then flags[#flags + 1] = "HIDE"   end
    if get(RC.enable, true)   then flags[#flags + 1] = "RCS"    end
    if get(PL.enable, true)   then flags[#flags + 1] = "ESP"    end
    if get(PL.chams, true)    then flags[#flags + 1] = "CHAMS"  end
    txt(sw - 292, 12, C.accent, "neverse")
    txt(sw - 228, 12, C.white, "| " .. table.concat(flags, "  "))
end

local function draw_indicators()
    if not get(MN.indicators, true) then return end
    local sw, sh = screen()
    local y = sh / 2 + 40
    if Target then
        txt(sw / 2 + 40, y, C.heal, "target: " .. pname(Target))
        y = y + 14
    end
    if get(SA.autofire, false) then txt(sw / 2 + 40, y, C.hurt, "auto fire") end
end

--====================== 11. CHAMS ====================================
local function apply_chams()
    local col = esp_color()
    local packed = col[1] + col[2] * 256 + col[3] * 65536
    local enabled = get(PL.chams, true)
    for _, e in ipairs(enemies()) do
        if alive(e) then
            if enabled then
                call("entity.set_prop", e, "m_bGlowEnabled", 1)
                call("entity.set_prop", e, "m_iGlowType", 3)
                call("entity.set_prop", e, "m_nGlowRange", 0)
                call("entity.set_prop", e, "m_glowColorOverride", packed)
            else
                call("entity.set_prop", e, "m_bGlowEnabled", 0)
            end
        end
    end
end

--====================== 12. HOOKS ====================================
local HookPath = nil

local function find_hook()
    if HookPath then return HookPath end
    for _, p in ipairs({
        "client.set_event_callback",
        "client.register_callback",
        "engine.set_event_callback",
    }) do
        if type(api(p)) == "function" then HookPath = p return p end
    end
    return nil
end

local function on_event(ev, fn)
    local p = find_hook()
    if not p then return false end
    local f = api(p)
    if pcall(f, ev, fn) then return true end
    if pcall(f, { [ev] = fn }) then return true end
    return false
end

local registered = 0

local function hook(ev, fn)
    if on_event(ev, fn) then registered = registered + 1 end
end

hook("setup_command", function(cmd)
    pcall(function()
        record()
        rcs()
        silent_aim(cmd)
    end)
end)

hook("net_update_end", function() pcall(record) end)

hook("paint", function()
    pcall(draw_esp)
    pcall(draw_fov)
    pcall(draw_crosshair)
    pcall(draw_lock)
    pcall(draw_watermark)
    pcall(draw_indicators)
    pcall(apply_chams)
end)

hook("round_start", function()
    Records = {}
    rcs_x, rcs_y = 0, 0
    Target, TargetAng = nil, nil
end)

hook("level_init", function()
    Records = {}
    Target, TargetAng = nil, nil
end)

hook("shutdown", function()
    Records = {}
    local setProp = api("entity.set_prop")
    if type(setProp) == "function" then
        for _, e in ipairs(call("entity.get_players", false) or {}) do
            pcall(setProp, e, "m_bGlowEnabled", 0)
        end
    end
end)

